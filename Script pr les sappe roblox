--========================================================
-- DRAG GLOBAL
--========================================================

UserInputService.InputChanged:Connect(function(input)

	if input.UserInputType ~=
		Enum.UserInputType.MouseMovement then

		return

	end

	-- CLOTHING

	if clothingDragging then

		local delta =
			input.Position -
			clothingDragStart

		clothing.Position =
			UDim2.new(
				clothingStartPosition.X.Scale,
				clothingStartPosition.X.Offset
					+ delta.X,

				clothingStartPosition.Y.Scale,
				clothingStartPosition.Y.Offset
					+ delta.Y
			)

	end

	-- SEARCH

	if searchDragging then

		local delta =
			input.Position -
			searchDragStart

		search.Position =
			UDim2.new(
				searchStartPosition.X.Scale,
				searchStartPosition.X.Offset
					+ delta.X,

				searchStartPosition.Y.Scale,
				searchStartPosition.Y.Offset
					+ delta.Y
			)

	end

	-- SAVED

	if savedDragging then

		local delta =
			input.Position -
			savedDragStart

		saved.Position =
			UDim2.new(
				savedStartPosition.X.Scale,
				savedStartPosition.X.Offset
					+ delta.X,

				savedStartPosition.Y.Scale,
				savedStartPosition.Y.Offset
					+ delta.Y
			)

	end

end)

