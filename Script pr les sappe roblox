--========================================================
-- PREVIEW
--========================================================

local function createPreview(
	parent,
	outfit
)

	local viewport =
		Instance.new(
			"ViewportFrame"
		)

	viewport.Size =
		UDim2.fromOffset(
			130,
			150
		)

	viewport.Position =
		UDim2.fromOffset(
			10,
			10
		)

	viewport.BackgroundColor3 =
		Color3.fromRGB(
			12,
			12,
			12
		)

	viewport.BorderSizePixel = 0

	viewport.Ambient =
		Color3.fromRGB(
			200,
			200,
			200
		)

	viewport.LightColor =
		Color3.fromRGB(
			255,
			255,
			255
		)

	viewport.LightDirection =
		Vector3.new(
			-1,
			-1,
			-1
		)

	viewport.Parent = parent

	addCorner(viewport, 8)

	local world =
		Instance.new(
			"WorldModel"
		)

	world.Parent = viewport

	local character =
		player.Character

	if not character then
		return
	end

	character.Archivable = true

	local clone =
		character:Clone()

	if not clone then
		return
	end

	for _, object in ipairs(
		clone:GetDescendants()
		) do

		if object:IsA("Script")
			or object:IsA("LocalScript")
			or object:IsA("ModuleScript")
			or object:IsA("Tool") then

			object:Destroy()
		end
	end

	for _, object in ipairs(
		clone:GetChildren()
		) do

		if object:IsA("Shirt")
			or object:IsA("Pants")
			or object:IsA("ShirtGraphic") then

			object:Destroy()
		end
	end

	if outfit.shirt
		and outfit.shirt ~= "" then

		local shirt =
			Instance.new("Shirt")

		shirt.ShirtTemplate =
			outfit.shirt

		shirt.Parent = clone
	end

	if outfit.pants
		and outfit.pants ~= "" then

		local pants =
			Instance.new("Pants")

		pants.PantsTemplate =
			outfit.pants

		pants.Parent = clone
	end

	clone.Parent = world

	clone:PivotTo(
		CFrame.new(
			0,
			0,
			0
		)
	)

	local camera =
		Instance.new("Camera")

	camera.CFrame =
		CFrame.new(
			Vector3.new(
				0,
				2.5,
				8
			),
			Vector3.new(
				0,
				2.5,
				0
			)
		)

	camera.Parent = viewport

	viewport.CurrentCamera =
		camera
end

--========================================================
-- REFRESH LIST
--========================================================

local function refreshOutfits()

	for _, child in ipairs(
		list:GetChildren()
		) do

		if child:IsA("Frame") then
			child:Destroy()
		end
	end

